# ---------------------------------------------------------------- database
# Supabase: Project Settings -> Database -> Connection string (pooled for the app,
# direct for migrations). The worker and the collector use the service-role path.
DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres
PG_POOL_MAX=10

# ------------------------------------------------------------------- redis
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------- highlevel app
# Marketplace app credentials (agency-level / user_type=Company install).
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3001/oauth/callback
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Shared secret HighLevel signs webhooks with. Leave empty only in local dev:
# when set, an unsigned webhook is rejected.
GHL_WEBHOOK_SECRET=

# --------------------------------------------------------------- collector
PORT=3001
HOST=0.0.0.0
# MaxMind GeoLite2-City database, resolved locally — no per-event call to an
# external service (RF-02.2). Download it from maxmind.com and mount it here.
GEOIP_PATH=./GeoLite2-City.mmdb
# Optional: absolute path to tracking/pulse.min.js when the layout differs.
TRACKING_SCRIPT_PATH=

# ------------------------------------------------------------------ worker
WORKER_CONCURRENCY=8
LOG_LEVEL=info
# SMTP connection string for alert e-mail. Without it alerts are still recorded
# and shown in the panel, they just aren't delivered.
SMTP_URL=
ALERT_FROM=Pulse <alerts@pulse.app>

# --------------------------------------------------------------------- web
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:3001
